---
const repo = 'HexaGhost-09/blog';
const repoId = 'R_kgDOVmddxQ';
const category = 'General';
const categoryId = 'DIC_kwDOVmddxc4DLMas';
// jsDelivr serves GitHub files with the CORS headers required by Giscus custom themes.
const theme = 'https://cdn.jsdelivr.net/gh/HexaGhost-09/blog@main/public/giscus-theme.css';
---

<div class="giscus-shell">
  <div
    class="giscus"
    data-giscus
    data-repo={repo}
    data-repo-id={repoId}
    data-category={category}
    data-category-id={categoryId}
    data-theme={theme}
  ></div>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-giscus]');
  if (container && !container.querySelector('script')) {
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    const config: Record<string, string> = {
      repo: container.dataset.repo ?? '',
      'repo-id': container.dataset.repoId ?? '',
      category: container.dataset.category ?? 'General',
      'category-id': container.dataset.categoryId ?? '',
      mapping: 'pathname',
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'bottom',
      theme: container.dataset.theme ?? 'preferred_color_scheme',
      lang: 'en',
      loading: 'lazy',
    };
    for (const [key, value] of Object.entries(config)) {
      script.setAttribute('data-' + key, value);
    }
    container.appendChild(script);
  }
</script>
