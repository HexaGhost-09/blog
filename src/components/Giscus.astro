---
const repo = 'HexaGhost-09/blog';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Comments';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const configured = Boolean(repoId && categoryId);
---

<div class="giscus-shell">
  {configured ? (
    <div class="giscus" data-giscus></div>
  ) : (
    <p class="giscus-setup">Comments are ready to connect. Add the Giscus repository and category IDs to the site's public environment variables to activate the discussion widget.</p>
  )}
</div>

{configured && <script is:inline define:vars={{ repo, repoId, category, categoryId }}>
  const container = document.querySelector('[data-giscus]');
  if (container && !container.querySelector('script')) {
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    const config = {
      repo,
      'repo-id': repoId,
      category,
      'category-id': categoryId,
      mapping: 'pathname',
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'top',
      theme: 'preferred_color_scheme',
      lang: 'en',
      loading: 'lazy',
    };
    for (const [key, value] of Object.entries(config)) {
      script.setAttribute('data-' + key, value);
    }
    container.appendChild(script);
  }
</script>}
