---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  { number: '01', name: 'FitGirl Pastebin Link Extractor', type: 'Automation · Python', description: 'A utility project focused on extracting and processing download links from pasted sources.', href: 'https://github.com/HexaGhost-09/Fitgirl-Pastebin-link-extractor', label: 'View repository' },
  { number: '02', name: 'HexaGhost Blog', type: 'Web · Astro', description: 'A personal publishing space for technical notes, experiments, guides and things worth documenting.', href: 'https://github.com/HexaGhost-09/blog', label: 'View source' },
];
const focus = ['Web development', 'Automation & scripting', 'Android and Linux', 'Open-source tools'];
---

<Base title="Portfolio demo" description="A portfolio preview for HexaGhost — projects, interests and experiments.">
  <section class="portfolio-page">
    <div class="portfolio-hero">
      <span class="demo-label"><span></span> PORTFOLIO PREVIEW</span>
      <p class="eyebrow">HELLO, I'M</p>
      <h1>HexaGhost<span>.</span></h1>
      <p class="portfolio-lead">A curious builder exploring software, automation and the open web. I like turning practical problems into useful little tools.</p>
      <div class="portfolio-cta">
        <a class="portfolio-primary" href="https://github.com/HexaGhost-09" target="_blank" rel="noreferrer"> <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.2 1.3-4.2-2.1-5.9-2.5M14.9 21v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.3 6a4.3 4.3 0 0 0-.1-3.2S17.2 2.5 14.9 4a12 12 0 0 0-6 0C6.6 2.5 5.6 2.8 5.6 2.8A4.3 4.3 0 0 0 5.5 6a4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21"/></svg> GitHub profile ↗</a>
        <a class="portfolio-secondary" href={base + '/blog/'}>Read my posts</a>
      </div>
      <div class="portfolio-orbit" aria-hidden="true"><span>H</span><i></i><b></b></div>
    </div>

    <section class="portfolio-section">
      <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>Projects & experiments</h2></div><span>01 — 02</span></div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-card-top"><span>{project.number}</span><span class="project-type">{project.type}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a href={project.href} target="_blank" rel="noreferrer">{project.label} ↗</a>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-section focus-section">
      <div class="section-heading"><div><p class="eyebrow">WHAT I EXPLORE</p><h2>Areas of interest</h2></div></div>
      <div class="focus-grid">
        {focus.map((item, index) => <div class="focus-item"><span>0{index + 1}</span>{item}</div>)}
      </div>
    </section>

    <section class="portfolio-contact">
      <p class="eyebrow">LET'S CONNECT</p>
      <h2>Find me around the web.</h2>
      <p>Follow projects, explore the code or read the latest notes.</p>
      <a href="https://github.com/HexaGhost-09" target="_blank" rel="noreferrer">github.com/HexaGhost-09 ↗</a>
    </section>
    <p class="portfolio-footnote">This is a starter portfolio demo. Project details and profile content can be personalised later.</p>
  </section>
</Base>
