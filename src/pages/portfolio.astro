---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  {
    number: '01',
    name: 'FitGirl Pastebin Link Extractor',
    type: 'Automation · Python',
    description: 'A Python utility for extracting and processing download links from pasted text sources.',
    href: 'https://github.com/HexaGhost-09/Fitgirl-Pastebin-link-extractor',
    label: 'View source code',
  },
  {
    number: '02',
    name: 'HexaGhost Blog',
    type: 'Web development · Astro',
    description: 'A personal publishing platform for technical notes, practical guides, software experiments and project documentation.',
    href: 'https://github.com/HexaGhost-09/blog',
    label: 'Explore the repository',
  },
];
const focus = ['Web development', 'Python automation', 'Android & customisation', 'Linux & open-source software'];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'HexaGhost',
  url: 'https://hexaghost-09.pntr.dev/portfolio/',
  description: 'Independent developer exploring web development, Python automation, Android, Linux and open-source software.',
  sameAs: ['https://github.com/HexaGhost-09'],
  knowsAbout: ['Web development', 'Python', 'Automation', 'Android', 'Linux', 'Open-source software', 'Astro'],
};
---

<Base
  title="Developer Portfolio — Web, Android, Linux & Automation"
  description="Explore HexaGhost's developer portfolio: web projects, Python automation, Android and Linux experiments, and open-source tools built to solve practical problems."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <section class="portfolio-page">
    <div class="portfolio-hero">
      <span class="demo-label"><span></span> INDEPENDENT DEVELOPER · OPEN SOURCE</span>
      <p class="eyebrow">HELLO, I'M</p>
      <h1>HexaGhost<span>.</span></h1>
      <p class="portfolio-lead">I explore web development, Python automation, Android and Linux. This is where I share useful tools, open-source projects and experiments built while learning how technology works.</p>
      <div class="portfolio-cta">
        <a class="portfolio-primary" href="https://github.com/HexaGhost-09" target="_blank" rel="noopener noreferrer" aria-label="Visit HexaGhost on GitHub"> <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.2 1.3-4.2-2.1-5.9-2.5M14.9 21v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.3 6a4.3 4.3 0 0 0-.1-3.2S17.2 2.5 14.9 4a12 12 0 0 0-6 0C6.6 2.5 5.6 2.8 5.6 2.8A4.3 4.3 0 0 0 5.5 6a4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21"/></svg> GitHub profile ↗</a>
        <a class="portfolio-secondary" href={base + '/blog/'}>Read technical notes</a>
      </div>
      <div class="portfolio-orbit" aria-hidden="true"><span>H</span><i></i><b></b></div>
    </div>

    <section class="portfolio-section" aria-labelledby="projects-heading">
      <div class="section-heading">
        <div><p class="eyebrow">SELECTED WORK</p><h2 id="projects-heading">Developer projects & experiments</h2></div>
        <span>01 — 02</span>
      </div>
      <p class="portfolio-section-intro">A selection of things I've built and maintain. Each project links to its source so you can explore the implementation, code and progress.</p>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-card-top"><span>{project.number}</span><span class="project-type">{project.type}</span></div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a href={project.href} target="_blank" rel="noopener noreferrer">{project.label} ↗</a>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-section focus-section" aria-labelledby="focus-heading">
      <div class="section-heading"><div><p class="eyebrow">WHAT I EXPLORE</p><h2 id="focus-heading">Technology interests</h2></div></div>
      <p class="portfolio-section-intro">My work and learning span software, operating systems and practical tools. I document what I discover and share useful results.</p>
      <div class="focus-grid">
        {focus.map((item, index) => <div class="focus-item"><span>0{index + 1}</span>{item}</div>)}
      </div>
    </section>

    <section class="portfolio-contact" aria-labelledby="connect-heading">
      <p class="eyebrow">LET'S CONNECT</p>
      <h2 id="connect-heading">Follow the work. Explore the code.</h2>
      <p>Browse my open-source repositories or read notes about the projects, systems and tools I'm exploring.</p>
      <div class="portfolio-cta">
        <a href="https://github.com/HexaGhost-09" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={base + '/blog/'}>Read the blog ↗</a>
        <a href={base + '/'}>Visit homepage ↗</a>
      </div>
    </section>
  </section>
</Base>
