---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <header><h1>{post.data.title}</h1><div class="meta"><time datetime={post.data.pubDate.toISOString()}>{date}</time>{post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((t) => <span>{t}</span>)}</span>}</div></header>
    <div class="prose"><Content /></div>
    <a class="back" href={`${base}/`}>All posts</a>
  </article>
</Base>
