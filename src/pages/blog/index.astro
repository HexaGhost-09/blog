---
import Base from '../../layouts/Base.astro';
import { sanity, postQuery } from '../../lib/sanity';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await sanity.fetch(postQuery);
const years = [...new Set(posts.map((post: any) => new Date(post.publishedAt).getFullYear()))].sort((a: number, b: number) => b - a);
const fmt = (value: string) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="All blog posts" description="Browse every article and guide published on HexaGhost.">
  <section class="blog-index">
    <p class="eyebrow">THE ARCHIVE</p>
    <h1>All blog posts</h1>
    <p class="intro">Guides, experiments and notes on Android, ChromeOS and Linux.</p>
    <div class="archive-toolbar">
      <a class="archive-link" href={base + '/blog/topics/'}>Browse by topic <span aria-hidden="true">→</span></a>
      <span class="archive-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
    </div>
    {years.map((year: number) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <div class="year-heading"><h2 id={`year-${year}`}>{year}</h2><span>{posts.filter((p: any) => new Date(p.publishedAt).getFullYear() === year).length} posts</span></div>
        <ul class="posts">
          {posts.filter((p: any) => new Date(p.publishedAt).getFullYear() === year).map((post: any) => (
            <li class="post-card"><a href={base + '/blog/' + post.slug + '/'}>
              {post.coverUrl && <img class="post-card-cover" src={post.coverUrl} alt={post.coverAlt || ''} loading="lazy" />}
              <div class="post-card-content"><time datetime={post.publishedAt}>{fmt(post.publishedAt)}</time><h3>{post.title}</h3><p>{post.description}</p>
                {post.tags?.length > 0 && <div class="archive-tags">{post.tags.map((tag: string) => <span>{tag}</span>)}</div>}
              </div>
            </a></li>
          ))}
        </ul>
      </section>
    ))}
    <a class="back" href={base + '/'}>← Back to home</a>
  </section>
</Base>
