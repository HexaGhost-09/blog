---
import Base from '../../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

export async function getStaticPaths() {
  const { sanity, postQuery } = await import('../../../lib/sanity');
  const allPosts = await sanity.fetch(postQuery);

  const tagNames = new Map<string, string>();
  for (const post of allPosts || []) {
    for (const value of Array.isArray(post.tags) ? post.tags : []) {
      if (typeof value !== 'string') continue;
      const tag = value.trim();
      if (tag && !tagNames.has(tag.toLowerCase())) {
        tagNames.set(tag.toLowerCase(), tag);
      }
    }
  }

  const usedSlugs = new Set<string>();
  const paths = [];

  for (const [key, tag] of tagNames) {
    const baseSlug = tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    if (!baseSlug) continue;

    let slug = baseSlug;
    let suffix = 2;
    while (usedSlugs.has(slug)) {
      slug = baseSlug + '-' + suffix++;
    }
    usedSlugs.add(slug);

    const posts = (allPosts || []).filter((post: any) =>
      Array.isArray(post.tags) &&
      post.tags.some((value: unknown) =>
        typeof value === 'string' && value.trim().toLowerCase() === key
      )
    );

    paths.push({ params: { tag: slug }, props: { name: tag, posts } });
  }

  return paths;
}

const { name, posts } = Astro.props;
const fmt = (value: string) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={name + ' articles'} description={'Articles filed under ' + name + '.'}>
  <section class="blog-index topic-page">
    <p class="eyebrow">TOPIC ARCHIVE</p><h1>{name}</h1>
    <p class="intro">{posts.length} {posts.length === 1 ? 'article' : 'articles'} filed under this topic.</p>
    <ul class="posts">{posts.map((post: any) => <li class="post-card"><a href={base + '/blog/' + post.slug + '/'}><div class="post-card-content"><time datetime={post.publishedAt}>{fmt(post.publishedAt)}</time><h2>{post.title}</h2><p>{post.description}</p></div></a></li>)}</ul>
    <a class="back" href={base + '/blog/topics/'}>← All topics</a>
  </section>
</Base>
