---
import Base from '../../../layouts/Base.astro';
import { sanity, postQuery } from '../../../lib/sanity';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await sanity.fetch(postQuery);
const tags = [...new Set(posts.flatMap((post: any) => post.tags || []))].sort((a: string, b: string) => a.localeCompare(b));
const topics = tags.map((name: string) => ({ name, slug: name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''), count: posts.filter((p: any) => p.tags?.some((tag: string) => tag.toLowerCase() === name.toLowerCase())).length }));
---
<Base title="Browse topics" description="Explore HexaGhost articles grouped by topic.">
  <section class="blog-index topics-index">
    <p class="eyebrow">EXPLORE THE ARCHIVE</p><h1>Browse topics</h1>
    <p class="intro">Choose a topic to see related guides, notes and experiments.</p>
    <p class="topic-total">{topics.length} topics · {posts.length} articles</p>
    <div class="topic-grid">
      {topics.map((topic) => <a class="topic-card" href={base + '/blog/topics/' + topic.slug + '/'}><span class="topic-name">{topic.name}</span><span class="topic-count">{topic.count} {topic.count === 1 ? 'post' : 'posts'} <span aria-hidden="true">↗</span></span></a>)}
    </div>
    <a class="back" href={base + '/blog/'}>← All blog posts</a>
  </section>
</Base>
