---
import Base from '../layouts/Base.astro';
import { sanity, postQuery } from '../lib/sanity';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await sanity.fetch(postQuery);
const fmt = (value: string) => new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="HexaGhost">
  <section class="hero">
    <div class="hero-stickers" aria-hidden="true">
      <img class="hero-sticker hero-sticker-flame" src={base + '/stickers/Flame.svg'} alt="" width="72" height="80" />
      <img class="hero-sticker hero-sticker-nori" src={base + '/stickers/nori-laptop.svg'} alt="" width="104" height="104" />
      <img class="hero-sticker hero-sticker-sparkles" src={base + '/stickers/Sparkles.svg'} alt="" width="54" height="54" />
    </div>
    <p class="eyebrow">HEXAGHOST</p>
    <h1>Build logs & notes</h1>
    <p>ChromeOS, Linux, Android and the things I tinker with.</p>
  </section>
  {posts.length === 0 ? (
    <p class="empty">No posts yet. Publish your first post from the Sanity admin.</p>
  ) : (
    <ul class="posts">
      {posts.map((post: any) => (
        <li class="post-card">
          <a href={base + '/blog/' + post.slug + '/'}>
            {post.coverUrl && <img class="post-card-cover" src={post.coverUrl} alt={post.coverAlt || ''} loading="lazy" />}
            <div class="post-card-content">
              <time datetime={post.publishedAt}>{fmt(post.publishedAt)}</time>
              <h2>{post.title}</h2>
              <p>{post.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
